# ⚠️ 本機開發警告
# 這個 repo 的 .env.local 可能是 v1 時期留下的舊檔，並指向「正式（PRODUCTION）」
# 的 Supabase 專案。若直接 `npm run dev` / `npm run build` / `npm run test:e2e`，
# 會打到正式資料庫。本機工作請一律改用會注入本機 Supabase 環境的封裝指令：
#   npm run dev:local
#   npm run build:local
#   npm run test:e2e:local
# 這些指令透過 scripts/with-local-supabase.mjs 指向本機 Supabase（API 127.0.0.1:55321）。

# Browser-safe Supabase settings
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3100
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-anon-key

# Server-only Supabase credential. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key

# LINE / LIFF. Phase 1 demo does not require these values.
NEXT_PUBLIC_LIFF_ID=replace-with-liff-id

# M6 LINE credential envelope key ring (AES-256-GCM). Base64 of a 32-byte key,
# selected by key_version. Rotate by writing _V2 and keeping _V1 to decrypt legacy
# rows. Missing/short keys fail closed. This IS consumed now (connect/webhook/worker).
LINE_CREDENTIAL_MASTER_KEY_V1=base64-encoded-32-byte-key

# M6 real-channel seam (DEFERRED — the ONLY thing left for a live LINE connection).
# Until LINE_CHANNEL_LIVE is a non-empty value, createLineMessenger() returns the
# FakeLineMessenger and the whole outbound flow runs locally with no real api.line.me
# call. Set LINE_CHANNEL_LIVE=1 (and implement RealLineMessenger.pushMessage) only
# when live credentials exist. LINE_CHANNEL_PUSH_ENDPOINT is the push URL the real
# messenger will POST to; it stays unused while the fake is selected.
LINE_CHANNEL_LIVE=
LINE_CHANNEL_PUSH_ENDPOINT=https://api.line.me/v2/bot/message/push

# M7 AI intake extraction (LINE free-text → draft). createAiExtractor() returns the
# deterministic FakeAiExtractor until FIREWORKS_AI_LIVE is a non-empty value, so all
# extraction runs locally with no api.fireworks.ai call and AI failure still degrades
# to a manual draft. Set FIREWORKS_AI_LIVE=1 (and implement FireworksAiExtractor +
# provide FIREWORKS_API_KEY, server-only, never sent to the browser) only when the
# real model is wired.
FIREWORKS_AI_LIVE=
FIREWORKS_API_KEY=

# Server-only application secrets. Use independent random values per environment.
# The set below is the canonical required-secret list in docs/security.md §8.1
# (validate presence/length/format at startup, fail closed). Some are consumed
# now; others back milestones still at Spec stage (LINE M6, workers M8).
AUTH_SECRET=replace-with-at-least-32-random-bytes
PUBLIC_TOKEN_PEPPER=replace-with-at-least-32-random-bytes
CURSOR_SIGNING_KEY=replace-with-at-least-32-random-bytes
WORKER_SECRET=replace-with-at-least-32-random-bytes
CSRF_SECRET=replace-with-at-least-32-random-bytes

# Optional local test overrides
PLAYWRIGHT_BASE_URL=http://127.0.0.1:3100
# Local Mailpit/Inbucket URL for the pilot live-intake E2E magic-link step.
# scripts/with-local-supabase.mjs sets this to the running local mail server.
PILOT_MAIL_SERVER_URL=http://127.0.0.1:55324
