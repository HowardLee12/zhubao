{
  "name": "renoly",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "overrides": {
    "postcss": "8.5.19"
  },
  "scripts": {
    "dev": "next dev",
    "dev:local": "node scripts/with-local-supabase.mjs npm run dev -- --hostname 127.0.0.1 --port 3100",
    "build": "next build",
    "build:local": "node scripts/with-local-supabase.mjs npm run build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:unit": "vitest run --exclude 'tests/integration/**' --exclude 'tests/e2e/**'",
    "test:coverage": "vitest run --coverage --exclude 'tests/integration/**' --exclude 'tests/e2e/**'",
    "test:integration": "vitest run tests/integration",
    "test:sql": "supabase test db",
    "lint:db": "supabase db lint --local --level warning",
    "test:e2e": "playwright test",
    "test:e2e:local": "node scripts/with-local-supabase.mjs npm run test:e2e"
  },
  "dependencies": {
    "@line/liff": "^2.27.3",
    "@react-pdf/renderer": "^4.5.1",
    "@supabase/ssr": "^0.12.3",
    "@supabase/supabase-js": "^2.99.2",
    "@vercel/analytics": "^2.0.1",
    "image-size": "^2.0.2",
    "jose": "^6.2.1",
    "next": "^16.3.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "uuid": "^13.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/uuid": "^10.0.0",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9",
    "eslint-config-next": "^16.2.10",
    "jsdom": "^29.1.1",
    "supabase": "^2.109.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10",
    "yaml": "^2.9.0"
  }
}
